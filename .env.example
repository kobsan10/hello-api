# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit a real connection string.

# Atlas → Cluster → Connect → Drivers → Node.js. Replace <db_password> with the
# password of the database user you created.
MONGODB_URI="mongodb+srv://<username>:<db_password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>"

# Database the API reads and writes. Created on first insert.
MONGODB_DB="hello_api"
