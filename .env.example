# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit a real connection string.

# Atlas → Cluster → Connect → Drivers → Node.js. Replace <db_password> with the
# password of the database user you created.
MONGODB_URI="mongodb+srv://<username>:<db_password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>"

# Database the API reads and writes. Created on first insert.
MONGODB_DB="hello_api"

# First-run admin account, provisioned from env vars rather than the users collection.
ADMIN_USER=<your admin username>
ADMIN_PASS=<your admin password>
NODE_ENV=development

# Signs and verifies auth JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64').replace(/[^a-zA-Z0-9]/g,'').slice(0,32))"
JWT_SECRET=<a random 32-character alphanumeric string>

# Origin allowed to call this API with cookies (the deployed frontend's URL, no
# trailing slash). Defaults to the local Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173
